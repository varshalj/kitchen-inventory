# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase JWT signing secret (Project Settings → API → JWT Secret).
# Used by server-side voice/webhook handlers to mint user-scoped sessions.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Alexa skill backend (optional — only set when wiring up the Alexa skill)
# - HOUSEHOLD_USER_ID: the Supabase user uuid every Alexa voice request acts as
# - SKILL_ID: the Alexa Skill ID (amzn1.ask.skill...) for app-id binding
ALEXA_HOUSEHOLD_USER_ID=
ALEXA_SKILL_ID=

# ── LLM provider (required for AI features: scan, voice, meal plan, recipes) ──
# The app talks to any OpenAI-wire-compatible provider. Set ONE of the keys
# below; if both are set, OpenRouter wins.
#
# Recommended: OpenRouter — one key, hundreds of models (free + paid), per-key
# spend caps, and built-in fallback. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Legacy / direct OpenAI (backward compatible). Used only if OPENROUTER_API_KEY
# is unset. Note: with this path, model ids must be bare (e.g. gpt-4o-mini) — the
# "openai/" prefix in the defaults below is stripped automatically.
OPENAI_API_KEY=sk-...

# Optional: override the API base URL (e.g. a self-hosted gateway). Defaults to
# OpenRouter's URL when OPENROUTER_API_KEY is set, else OpenAI's.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Per-route model selection — change any of these WITHOUT a code change to move a
# route between free and paid models. Each accepts a comma-separated list: the
# first id is primary, the rest are OpenRouter fallbacks (tried on error /
# rate-limit, not on low quality). All default to openai/gpt-4o-mini.
# Vision-capable models are REQUIRED for LLM_MODEL_SCAN (it sends photos);
# structured-JSON support is required for SCAN, VOICE, and RECIPE.
#   e.g. LLM_MODEL_MEAL_PLAN=deepseek/deepseek-chat-v3:free,openai/gpt-4o-mini
# LLM_MODEL_SCAN=openai/gpt-4o-mini
# LLM_MODEL_VOICE=openai/gpt-4o-mini
# LLM_MODEL_MEAL_PLAN=openai/gpt-4o-mini
# LLM_MODEL_RECIPE=openai/gpt-4o-mini

# Optional: attribution shown on OpenRouter's usage leaderboard (harmless if unset).
# LLM_SITE_URL=https://kitchen-inventory.app
# LLM_APP_NAME=Kitchen Inventory

# Encryption key for user-provided API keys (required if using per-user AI keys)
KMS_MASTER_KEY=your-random-secret-key

# Email ingestion callback secret (authenticates Relay.app webhook calls)
EMAIL_CALLBACK_SECRET=your-email-callback-secret
